root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4
# Windows PowerShell 5.1 reads a script without a byte order mark in the
# system's code page: the scripts are kept to ASCII, so it reads them right.
charset = latin1

[*.md]
trim_trailing_whitespace = false
