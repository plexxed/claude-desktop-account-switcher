{
  // The compiler's settings are the mod's own; only the declarations of the
  // plugin API come from Claude Code, which writes them to .claude-plugin/types/
  // when it loads the mod (npm run types writes them without a session).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": ["./.claude-plugin/types"],
    "types": ["claude-code", "claude-code-tools", "claude-code-mcp"]
  },
  "include": ["hooks", "types", "tests"]
}
